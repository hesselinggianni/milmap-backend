APP_NAME="Crypto Trading Bot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database — sqlite by default for easy local dev.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Bot safety (all conservative defaults) ---
# Master enable — nothing trades until true.
BOT_ENABLED=false
# Runtime kill-switch.
BOT_KILL_SWITCH=false
# Static bearer token protecting the dashboard API (empty = open, local only).
BOT_API_TOKEN=

# Markets (start with ONE) and candle interval.
BOT_PAIRS=BTC-EUR
BOT_CANDLE_INTERVAL=1h

# Paper trading.
BOT_PAPER_STARTING_EUR=1000
BOT_PAPER_FEE_BPS=25
BOT_PAPER_SLIPPAGE_BPS=5

# Real trading gate — KEEP FALSE until phase 3. Requires Bitvavo keys.
BOT_REAL_ENABLED=false
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Risk limits.
BOT_MAX_POSITION_PCT=0.20
BOT_MAX_POSITION_EUR=250
BOT_MAX_DAILY_LOSS_PCT=0.05
BOT_MAX_DRAWDOWN_PCT=0.20
BOT_MIN_ORDER_EUR=10

# Auto-deposit (paper only) with hard lifetime cap.
BOT_DEPOSIT_ENABLED=false
BOT_DEPOSIT_PER_TOPUP_EUR=100
BOT_DEPOSIT_MAX_LIFETIME_EUR=1000
BOT_DEPOSIT_STOP_ON_CAP=true

# Claude LLM strategy.
ANTHROPIC_API_KEY=
BOT_LLM_MODEL=claude-opus-4-8
BOT_LLM_MAX_CALLS_PER_DAY=24

# CORS origin voor het Vue-dashboard. Elke localhost-poort is sowieso
# toegestaan via config/cors.php; pas dit alleen aan voor een niet-localhost host.
CORS_ALLOWED_ORIGINS=http://localhost:3000
